# Supabase panelinde:  Project Settings -> API
#
#   Project URL       -> VITE_SUPABASE_URL
#   Publishable key   -> VITE_SUPABASE_ANON_KEY
#     (Supabase bu anahtarin adini degistirdi; eskiden "anon public" idi.
#      Yeni projelerde "sb_publishable_..." ile baslar, eskilerde "eyJ..." ile.)
#
# IKISINI KARISTIRMA: ustteki adres, alttaki anahtar.
#
# Bu iki deger GIZLI DEGILDIR; uygulamanin icinde herkese gorunur.
# Guvenligi saglayan sey veritabanindaki satir kurallaridir.
#
# "Secret key" / "service_role" anahtarini ASLA buraya koyma.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
